#!/bin/sh
set -eu
msg_file="$1"
subject=$(sed -n '1p' "$msg_file")

case "$subject" in
  Merge*|Revert*|fixup!*|squash!*|amend!*) exit 0 ;;
esac

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|chore|docs|perf|refactor|test|build|ci|style)(\([a-z0-9._/-]+\))?!?: .+'; then
  echo "✗ not a Conventional Commit subject:" >&2
  echo "  $subject" >&2
  echo "  expected: <type>(<scope>)?: <imperative subject>" >&2
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "✗ subject is ${#subject} chars, limit is 72" >&2
  exit 1
fi

case "$subject" in
  *.) echo "✗ subject ends with a period" >&2; exit 1 ;;
esac

if grep -Eiq 'co-authored-by:.*(claude|anthropic)|generated with .*claude|🤖' "$msg_file"; then
  echo "✗ assistant attribution in the commit message" >&2
  exit 1
fi
