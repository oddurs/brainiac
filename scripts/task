#!/bin/sh
# The seam. CI and the git hooks know only these verbs, so they cannot drift.
set -eu

usage() { echo "usage: scripts/task {fmt|fmt:check|lint|test|build|check}" >&2; exit 2; }

run() { echo "→ $*"; "$@"; }

case "${1:-}" in
  fmt)       run cargo fmt --all ;;
  fmt:check) run cargo fmt --all -- --check ;;
  lint)      run cargo clippy --all-targets --all-features -- -D warnings ;;
  test)      run cargo test --all-features ;;
  build)     run cargo build --release --all-features ;;
  check)
    "$0" fmt:check
    "$0" lint
    "$0" test
    "$0" build
    echo "✓ check passed"
    ;;
  *) usage ;;
esac
